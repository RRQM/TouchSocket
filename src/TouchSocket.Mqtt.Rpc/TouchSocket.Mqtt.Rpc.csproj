<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net462;netstandard2.0;netstandard2.1;net6.0;net10.0;net8.0</TargetFrameworks>
		<PackageTags>MqttRpc;TouchSocket</PackageTags>
		<Description>这是一个提供基于Mqtt协议的Rpc服务器和客户端的组件库。可以通过该组件在MqttClient之间实现Rpc调用。

说明文档：https://touchsocket.net/	</Description>
		<Title>TouchSocket.Mqtt.Rpc</Title>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Include="..\TouchSocket.Shared\Core\ThrowHelperCore.cs" Link="Exceptions\ThrowHelperCore.cs" />
	  <Compile Include="..\TouchSocket.Shared\Rpc\ThrowHelperRpc.cs" Link="Exceptions\ThrowHelperRpc.cs" />
	  <Compile Include="..\TouchSocket.Shared\Sockets\ThrowHelperSockets.cs" Link="Exceptions\ThrowHelperSockets.cs" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Exceptions\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\TouchSocket.SourceGenerator.SharedProject\tools\*.ps1" PackagePath="tools" Pack="true" Visible="false" />
		<None Include="..\TouchSocket.Mqtt.Rpc.SourceGenerator\bin\$(Configuration)\netstandard2.0\TouchSocket.Mqtt.Rpc.SourceGenerator.dll" PackagePath="analyzers\dotnet\cs" Pack="true" Visible="false" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\TouchSocket.Mqtt\TouchSocket.Mqtt.csproj" />
	  <ProjectReference Include="..\TouchSocket.Rpc\TouchSocket.Rpc.csproj" />
	</ItemGroup>

</Project>
